# Set through the deployment secret store. Do not commit actual values.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=your-domain.example
DATABASE_PATH=/var/data/coffee.sqlite3
DEMO_MODE=0
POLICIES_APPROVED=0
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# Browser smoke tests only (not application runtime)
# CHROMIUM_PATH=/usr/bin/chromium

# Set to 1 only after verifying your reverse proxy overwrites X-Forwarded-Proto.
TRUST_HTTPS_PROXY=0
